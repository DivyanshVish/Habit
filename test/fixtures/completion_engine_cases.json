{
  "_comment": "Shared by the Dart test and the TypeScript test. Keep both engines in sync with these cases.",
  "progress": [
    { "name": "PRD example: 10 eligible, 80% target, 7 done",
      "rule": { "type": "percentage", "value": 80 }, "eligible": 10, "completed": 7,
      "expect": { "hasTarget": true, "required": 8, "remaining": 1, "percent": 70, "reached": false } },
    { "name": "PRD example: 8th completion reaches the target",
      "rule": { "type": "percentage", "value": 80 }, "eligible": 10, "completed": 8,
      "expect": { "hasTarget": true, "required": 8, "remaining": 0, "percent": 80, "reached": true } },
    { "name": "PRD shared habit: 3 of 5 shows 60%",
      "rule": { "type": "individual" }, "eligible": 5, "completed": 3,
      "expect": { "hasTarget": false, "required": 0, "remaining": 0, "percent": 60, "reached": false } },
    { "name": "individual never reaches a target",
      "rule": { "type": "individual" }, "eligible": 4, "completed": 4,
      "expect": { "hasTarget": false, "required": 0, "remaining": 0, "percent": 100, "reached": false } },
    { "name": "majority of 10 needs 6",
      "rule": { "type": "majority" }, "eligible": 10, "completed": 5,
      "expect": { "hasTarget": true, "required": 6, "remaining": 1, "percent": 50, "reached": false } },
    { "name": "majority of 10 reached at 6",
      "rule": { "type": "majority" }, "eligible": 10, "completed": 6,
      "expect": { "hasTarget": true, "required": 6, "remaining": 0, "percent": 60, "reached": true } },
    { "name": "majority of 5 needs 3",
      "rule": { "type": "majority" }, "eligible": 5, "completed": 2,
      "expect": { "hasTarget": true, "required": 3, "remaining": 1, "percent": 40, "reached": false } },
    { "name": "majority of 1 needs 1",
      "rule": { "type": "majority" }, "eligible": 1, "completed": 0,
      "expect": { "hasTarget": true, "required": 1, "remaining": 1, "percent": 0, "reached": false } },
    { "name": "unanimous needs everyone",
      "rule": { "type": "unanimous" }, "eligible": 4, "completed": 3,
      "expect": { "hasTarget": true, "required": 4, "remaining": 1, "percent": 75, "reached": false } },
    { "name": "unanimous reached",
      "rule": { "type": "unanimous" }, "eligible": 4, "completed": 4,
      "expect": { "hasTarget": true, "required": 4, "remaining": 0, "percent": 100, "reached": true } },
    { "name": "fixed target of 3",
      "rule": { "type": "fixed", "value": 3 }, "eligible": 10, "completed": 2,
      "expect": { "hasTarget": true, "required": 3, "remaining": 1, "percent": 20, "reached": false } },
    { "name": "fixed target above eligible is capped",
      "rule": { "type": "fixed", "value": 20 }, "eligible": 6, "completed": 6,
      "expect": { "hasTarget": true, "required": 6, "remaining": 0, "percent": 100, "reached": true } },
    { "name": "fixed target below 1 is raised to 1",
      "rule": { "type": "fixed", "value": 0 }, "eligible": 6, "completed": 0,
      "expect": { "hasTarget": true, "required": 1, "remaining": 1, "percent": 0, "reached": false } },
    { "name": "percentage rounds the required count up",
      "rule": { "type": "percentage", "value": 70 }, "eligible": 3, "completed": 2,
      "expect": { "hasTarget": true, "required": 3, "remaining": 1, "percent": 66, "reached": false } },
    { "name": "percentage 100 behaves like unanimous",
      "rule": { "type": "percentage", "value": 100 }, "eligible": 7, "completed": 7,
      "expect": { "hasTarget": true, "required": 7, "remaining": 0, "percent": 100, "reached": true } },
    { "name": "percentage above 100 is capped",
      "rule": { "type": "percentage", "value": 250 }, "eligible": 4, "completed": 3,
      "expect": { "hasTarget": true, "required": 4, "remaining": 1, "percent": 75, "reached": false } },
    { "name": "percentage below 1 is raised to 1",
      "rule": { "type": "percentage", "value": 0 }, "eligible": 10, "completed": 0,
      "expect": { "hasTarget": true, "required": 1, "remaining": 1, "percent": 0, "reached": false } },
    { "name": "no eligible members never reaches a target",
      "rule": { "type": "majority" }, "eligible": 0, "completed": 0,
      "expect": { "hasTarget": true, "required": 0, "remaining": 0, "percent": 0, "reached": false } },
    { "name": "completed above eligible is clamped for percent",
      "rule": { "type": "unanimous" }, "eligible": 2, "completed": 5,
      "expect": { "hasTarget": true, "required": 2, "remaining": 0, "percent": 100, "reached": true } }
  ]
}

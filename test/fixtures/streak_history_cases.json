{
  "_comment": "Shared by the Dart and TypeScript streak calculators. Weekdays: 1 = Monday ... 7 = Sunday.",
  "cases": [
    { "name": "today before start", "done": [], "start": "2026-10-10", "today": "2026-10-09",
      "expect": { "currentStreak": 0, "bestStreak": 0, "completed": 0, "missed": 0 } },
    { "name": "new habit, nothing done, today open", "done": [], "start": "2026-10-10", "today": "2026-10-10",
      "expect": { "currentStreak": 0, "bestStreak": 0, "completed": 0, "missed": 0 } },
    { "name": "three days done including today", "done": ["2026-10-08", "2026-10-09", "2026-10-10"],
      "start": "2026-10-08", "today": "2026-10-10",
      "expect": { "currentStreak": 3, "bestStreak": 3, "completed": 3, "missed": 0 } },
    { "name": "today open keeps the streak", "done": ["2026-10-08", "2026-10-09"],
      "start": "2026-10-08", "today": "2026-10-10",
      "expect": { "currentStreak": 2, "bestStreak": 2, "completed": 2, "missed": 0 } },
    { "name": "missed day resets current but keeps best",
      "done": ["2026-10-01", "2026-10-02", "2026-10-03", "2026-10-04", "2026-10-05", "2026-10-07", "2026-10-08"],
      "start": "2026-10-01", "today": "2026-10-09",
      "expect": { "currentStreak": 2, "bestStreak": 5, "completed": 7, "missed": 1 } },
    { "name": "month boundary", "done": ["2026-10-29", "2026-10-30", "2026-10-31", "2026-11-01", "2026-11-02"],
      "start": "2026-10-29", "today": "2026-11-02",
      "expect": { "currentStreak": 5, "bestStreak": 5, "completed": 5, "missed": 0 } },
    { "name": "year boundary", "done": ["2026-12-30", "2026-12-31", "2027-01-01", "2027-01-02"],
      "start": "2026-12-30", "today": "2027-01-02",
      "expect": { "currentStreak": 4, "bestStreak": 4, "completed": 4, "missed": 0 } },
    { "name": "leap day", "done": ["2028-02-27", "2028-02-28", "2028-02-29", "2028-03-01"],
      "start": "2028-02-27", "today": "2028-03-01",
      "expect": { "currentStreak": 4, "bestStreak": 4, "completed": 4, "missed": 0 } },
    { "name": "Mon/Wed/Fri schedule all done", "done": ["2026-10-05", "2026-10-07", "2026-10-09"],
      "start": "2026-10-05", "today": "2026-10-11", "weekdays": [1, 3, 5],
      "expect": { "currentStreak": 3, "bestStreak": 3, "completed": 3, "missed": 0 } },
    { "name": "Mon/Wed/Fri with a missed Wednesday", "done": ["2026-10-05", "2026-10-09"],
      "start": "2026-10-05", "today": "2026-10-11", "weekdays": [1, 3, 5],
      "expect": { "currentStreak": 1, "bestStreak": 1, "completed": 2, "missed": 1 } },
    { "name": "completion on an unscheduled day is ignored", "done": ["2026-10-06"],
      "start": "2026-10-05", "today": "2026-10-06", "weekdays": [1, 3, 5],
      "expect": { "currentStreak": 0, "bestStreak": 0, "completed": 0, "missed": 1 } },
    { "name": "empty schedule", "done": ["2026-10-01"], "start": "2026-10-01", "today": "2026-10-03", "weekdays": [],
      "expect": { "currentStreak": 0, "bestStreak": 0, "completed": 0, "missed": 0 } }
  ]
}
